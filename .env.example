# ============ 大模型（必填）============
# DeepSeek 开放平台申请的 API Key：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ============ 可选：联网搜索增强 ============
# 都不填时 my_search 工具会自动降级为无密钥的 HTML 检索，功能可用但质量略低
# ZHIPU_API_KEY=xxxxxxxxxxxxxxxx.xxxxxxxxxxxxxxxx
# TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# ============ 本地 MCP 服务端 ============
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_SSE_PATH=/sse
MCP_STREAMABLE_PATH=/streamable

# ============ 产物目录 ============
# OUTPUT_DIR=./outputs
